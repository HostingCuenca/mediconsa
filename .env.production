# .env.production - Solo aplica en build de producción (Vercel)

# Desactiva el plugin de ESLint durante el build para que los
# warnings no rompan la compilación en CI (donde CI=true).
# ESLint sigue funcionando normalmente en desarrollo local.
DISABLE_ESLINT_PLUGIN=true

# Google Sign-In (client_id público). Debe coincidir con GOOGLE_CLIENT_ID del backend.
REACT_APP_GOOGLE_CLIENT_ID=862339884406-1di3vjt38ebgok3s2r7de915ctoh8u7j.apps.googleusercontent.com
