# .env - Variables de Entorno Mediconsa Frontend

# =============================================
# API CONFIGURATION
# =============================================
REACT_APP_API_URL=http://localhost:5001/med-api
REACT_APP_API_TIMEOUT=20000

# =============================================
# APP CONFIGURATION
# =============================================
REACT_APP_NAME=Mediconsa
REACT_APP_VERSION=2.0.0
REACT_APP_ENVIRONMENT=development

# =============================================
# GOOGLE SIGN-IN (solo el client_id, es público; el secret vive en el backend)
# =============================================
REACT_APP_GOOGLE_CLIENT_ID=862339884406-1di3vjt38ebgok3s2r7de915ctoh8u7j.apps.googleusercontent.com

# =============================================
# WHATSAPP INTEGRATION
# =============================================
REACT_APP_WHATSAPP_NUMBER=593985036066
REACT_APP_WHATSAPP_MESSAGE_PREFIX=Hola, soy un estudiante de Mediconsa

# =============================================
# ANALYTICS (opcional)
# =============================================
# REACT_APP_GOOGLE_ANALYTICS_ID=
# REACT_APP_HOTJAR_ID=

# =============================================
# PAYMENT INTEGRATION (futuro)
# =============================================
# REACT_APP_PAYMENT_GATEWAY_URL=
# REACT_APP_PAYMENT_PUBLIC_KEY=

# =============================================
# DEBUG MODE
# =============================================






REACT_APP_DEBUG=true
REACT_APP_SHOW_API_LOGS=true

